{
  "$id": "https://monorail.tech/schemas/tech.monorail.people.role/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A responsibility in an organization, such as security lead or data protection officer, and who holds it now. Policies and controls name the role that owns them.",
  "examples": [
    {
      "$type": "tech.monorail.people.role",
      "holders": [
        "person:ana-lima"
      ],
      "id": "security-lead",
      "name": "Security lead",
      "version": 1
    }
  ],
  "properties": {
    "$type": {
      "const": "tech.monorail.people.role"
    },
    "description": {
      "type": "string"
    },
    "holder_matches": {
      "description": "Otherwise. Each needs emails or identifiers.",
      "items": {
        "$ref": "https://legiblerecords.org/schemas/org.legiblerecords.common/v1.json#/$defs/personMatch"
      },
      "type": "array",
      "x-data": [
        "user.name",
        "user.contact.email.work",
        "user.unique_id"
      ]
    },
    "holders": {
      "description": "When the people travel in the same bundle.",
      "items": {
        "$ref": "https://legiblerecords.org/schemas/org.legiblerecords.common/v1.json#/$defs/refString",
        "ref": "person"
      },
      "type": "array",
      "x-data": [
        "user.unique_id"
      ]
    },
    "id": {
      "$ref": "https://legiblerecords.org/schemas/org.legiblerecords.common/v1.json#/$defs/slug",
      "description": "Such as security-lead, for references like role:security-lead."
    },
    "name": {
      "description": "Security lead, Data protection officer.",
      "type": "string"
    },
    "produced_by": {
      "$ref": "https://legiblerecords.org/schemas/org.legiblerecords.common/v1.json#/$defs/produced_by"
    },
    "source": {
      "$ref": "https://legiblerecords.org/schemas/org.legiblerecords.common/v1.json#/$defs/source"
    },
    "source_fields": {
      "description": "The source's own fields that no field here covers, under the source's names. Readers keep it and don't interpret it. Never a personal value that a field here would label.",
      "type": "object"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "$type",
    "version",
    "id",
    "name"
  ],
  "title": "role",
  "type": "object"
}
