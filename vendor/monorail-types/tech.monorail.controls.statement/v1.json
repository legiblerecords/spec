{
  "$id": "https://monorail.tech/schemas/tech.monorail.controls.statement/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A passage of a policy, with what kind of statement it is and, for a commitment, the controls that make it true. A commitment with neither controls nor no_control is a gap, and a reader shows it as one.",
  "examples": [
    {
      "$type": "tech.monorail.controls.statement",
      "controls": [
        "control:mfa"
      ],
      "id": "access-control-sso",
      "kind": "commitment",
      "policy": "policy:access-control",
      "text": "Everyone signs in with SSO and a passkey.",
      "version": 1
    }
  ],
  "properties": {
    "$type": {
      "const": "tech.monorail.controls.statement"
    },
    "audience": {
      "description": "Narrower than the policy's, by name.",
      "type": "string"
    },
    "basis": {
      "examples": [
        "stated",
        "implied"
      ],
      "type": "string"
    },
    "controls": {
      "description": "Empty for guidance and context, and for a commitment only with no_control.",
      "items": {
        "$ref": "https://legiblerecords.org/schemas/org.legiblerecords.common/v1.json#/$defs/refString",
        "ref": "control"
      },
      "type": "array"
    },
    "id": {
      "$ref": "https://legiblerecords.org/schemas/org.legiblerecords.common/v1.json#/$defs/slug"
    },
    "kind": {
      "examples": [
        "commitment",
        "guidance",
        "context"
      ],
      "type": "string"
    },
    "no_control": {
      "description": "Why a commitment has no control, and who accepted that.",
      "properties": {
        "accepted_at": {
          "$ref": "https://legiblerecords.org/schemas/org.legiblerecords.common/v1.json#/$defs/date"
        },
        "accepted_by": {
          "description": "By name.",
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "accepted_at",
        "accepted_by",
        "reason"
      ],
      "type": "object"
    },
    "note": {
      "type": "string"
    },
    "policy": {
      "$ref": "https://legiblerecords.org/schemas/org.legiblerecords.common/v1.json#/$defs/refString",
      "description": "The policy it is a passage of, which travels with it.",
      "ref": "policy"
    },
    "produced_by": {
      "$ref": "https://legiblerecords.org/schemas/org.legiblerecords.common/v1.json#/$defs/produced_by"
    },
    "scope": {
      "description": "Narrower than the policy's, by name.",
      "type": "string"
    },
    "source": {
      "$ref": "https://legiblerecords.org/schemas/org.legiblerecords.common/v1.json#/$defs/source"
    },
    "source_fields": {
      "description": "The source's own fields that no field here covers, under the source's names. Readers keep it and don't interpret it. Never a personal value that a field here would label.",
      "type": "object"
    },
    "text": {
      "description": "The passage as it appears in the policy's revision.",
      "type": "string"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "$type",
    "version",
    "controls",
    "id",
    "kind",
    "policy",
    "text"
  ],
  "title": "statement",
  "type": "object"
}
