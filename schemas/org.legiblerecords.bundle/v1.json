{
  "$id": "https://legiblerecords.org/schemas/org.legiblerecords.bundle/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The manifest of a bundle - every file it holds, with its hash.",
  "examples": [
    {
      "$type": "org.legiblerecords.bundle",
      "files": [
        {
          "path": "records/control/mfa-company-accounts.json",
          "record_type": "tech.monorail.controls.control",
          "record_version": 1,
          "sha256": "2c26b46b68ffc68ff99b453c1d30413413422d706483bfa0f98a5e886266e7ae"
        }
      ],
      "produced_by": {
        "app": "track",
        "build": "2026.11.21"
      },
      "version": 1
    }
  ],
  "properties": {
    "$type": {
      "const": "org.legiblerecords.bundle"
    },
    "based_on": {
      "description": "The bundle the publisher started from, such as one the reader sent it.",
      "properties": {
        "manifest_sha256": {
          "$ref": "https://legiblerecords.org/schemas/org.legiblerecords.common/v1.json#/$defs/sha256",
          "description": "Of that bundle's manifest.json, as stored."
        },
        "published_at": {
          "$ref": "https://legiblerecords.org/schemas/org.legiblerecords.common/v1.json#/$defs/datetime",
          "description": "That bundle's published_at, for people to read."
        }
      },
      "required": [
        "manifest_sha256"
      ],
      "type": "object"
    },
    "complete": {
      "description": "The types this bundle holds every record of, whatever their version. A record of one of these types that a reader holds and the bundle lacks was removed at the source. A type not listed may be partial.",
      "items": {
        "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$",
        "type": "string"
      },
      "type": "array"
    },
    "feed": {
      "description": "The feed and stream this bundle was published for.",
      "properties": {
        "id": {
          "$ref": "https://legiblerecords.org/schemas/org.legiblerecords.common/v1.json#/$defs/feedId",
          "description": "The feed's id, <publisher>/<slug>."
        },
        "stream": {
          "$ref": "https://legiblerecords.org/schemas/org.legiblerecords.common/v1.json#/$defs/slug",
          "description": "The stream within the feed."
        }
      },
      "required": [
        "id",
        "stream"
      ],
      "type": "object"
    },
    "files": {
      "items": {
        "properties": {
          "count": {
            "description": "For a record set, how many records it holds.",
            "minimum": 0,
            "type": "integer"
          },
          "media_type": {
            "description": "For an attachment.",
            "type": "string"
          },
          "path": {
            "description": "Relative to the bundle's root, with / separators.",
            "type": "string"
          },
          "record_type": {
            "description": "The record's $type, for a record.",
            "type": "string"
          },
          "record_version": {
            "description": "The record's version, for a record.",
            "minimum": 1,
            "type": "integer"
          },
          "sha256": {
            "$ref": "https://legiblerecords.org/schemas/org.legiblerecords.common/v1.json#/$defs/sha256"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "note": {
      "description": "What the bundle is and why it was made, in Markdown.",
      "type": "string"
    },
    "prepared_by": {
      "$ref": "https://legiblerecords.org/schemas/org.legiblerecords.common/v1.json#/$defs/personMatch",
      "description": "Who prepared the bundle, for a reader to ask about it. What the bundle says, not proof of who sent it."
    },
    "produced_by": {
      "$ref": "https://legiblerecords.org/schemas/org.legiblerecords.common/v1.json#/$defs/produced_by"
    },
    "published_at": {
      "$ref": "https://legiblerecords.org/schemas/org.legiblerecords.common/v1.json#/$defs/datetime",
      "description": "When the publisher made this bundle. Required when the bundle is in a feed."
    },
    "record_notes": {
      "description": "Notes on single records, such as why one changed or was removed.",
      "items": {
        "properties": {
          "key": {
            "$ref": "https://legiblerecords.org/schemas/org.legiblerecords.common/v1.json#/$defs/slug",
            "description": "The record's id. The record need not be in the bundle, so that a note can explain a removal."
          },
          "note": {
            "description": "In Markdown.",
            "type": "string"
          },
          "type": {
            "description": "The record's $type.",
            "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$",
            "type": "string"
          }
        },
        "required": [
          "type",
          "key",
          "note"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "source": {
      "$ref": "https://legiblerecords.org/schemas/org.legiblerecords.common/v1.json#/$defs/source"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "$type",
    "version",
    "files"
  ],
  "title": "bundle",
  "type": "object"
}
