{
  "$type": "org.legiblerecords.feed-connection",
  "version": 1,
  "feed": "acme.example/track",
  "location": { "kind": "https", "url": "https://outpost.acme.example/feeds/track/" },
  "auth": {
    "method": "oauth-client-credentials",
    "token_url": "https://id.acme.example/api/oidc/token",
    "client_id": "monorail-track",
    "client_secret_env": "ACME_FEED_CLIENT_SECRET",
    "resource": "https://outpost.acme.example/",
    "scope": "feeds:read"
  }
}
