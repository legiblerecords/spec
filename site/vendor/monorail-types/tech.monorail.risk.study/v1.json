{
  "$defs": {
    "curve": {
      "description": "One simulated loss curve. Each period draws its events from the likelihood, and a loss from the impact for each event.",
      "properties": {
        "clamped_share": {
          "description": "The share of probability draws clamped into 0 to 1.",
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "exceedance_counts": {
          "description": "Exactly how many periods had a loss at least this large, counted from every period. Rare losses are read from these, not from points.",
          "items": {
            "properties": {
              "loss": {
                "minimum": 0,
                "type": "number"
              },
              "periods": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "loss",
              "periods"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "expected_loss": {
          "description": "The mean loss per period, periods without a loss included.",
          "minimum": 0,
          "type": "number"
        },
        "generator": {
          "description": "The random number generator that seed is for.",
          "examples": [
            "mulberry32"
          ],
          "type": "string"
        },
        "impact": {
          "$ref": "#/$defs/range",
          "description": "The range simulated."
        },
        "impact_fit": {
          "$ref": "#/$defs/fit"
        },
        "impact_pooling": {
          "description": "Which of the panel's pooled impacts was simulated.",
          "examples": [
            "mean",
            "median"
          ],
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "likelihood": {
          "$ref": "#/$defs/range",
          "description": "The range simulated."
        },
        "likelihood_fit": {
          "$ref": "#/$defs/fit"
        },
        "likelihood_pooling": {
          "description": "Which of the panel's pooled likelihoods was simulated.",
          "examples": [
            "mean",
            "median"
          ],
          "type": "string"
        },
        "loss_percentiles": {
          "description": "The loss per period at each percentile of the simulated periods.",
          "properties": {
            "max": {
              "minimum": 0,
              "type": "number"
            },
            "p50": {
              "minimum": 0,
              "type": "number"
            },
            "p90": {
              "minimum": 0,
              "type": "number"
            },
            "p95": {
              "minimum": 0,
              "type": "number"
            },
            "p99": {
              "minimum": 0,
              "type": "number"
            }
          },
          "required": [
            "max",
            "p50",
            "p90",
            "p95",
            "p99"
          ],
          "type": "object"
        },
        "points": {
          "description": "The curve as drawn, ascending in loss.",
          "items": {
            "properties": {
              "loss": {
                "minimum": 0,
                "type": "number"
              },
              "probability": {
                "description": "The share of periods with a loss at least this large.",
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              }
            },
            "required": [
              "loss",
              "probability"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "probability_of_loss": {
          "description": "The share of periods with at least one event.",
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "seed": {
          "type": "integer"
        },
        "trials": {
          "description": "How many periods were simulated.",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "expected_loss",
        "impact",
        "impact_fit",
        "impact_pooling",
        "likelihood",
        "likelihood_fit",
        "likelihood_pooling",
        "loss_percentiles",
        "probability_of_loss",
        "trials"
      ],
      "type": "object"
    },
    "fit": {
      "description": "A lognormal fitted to a range as this record holds it, so a probability's fit is of the value from 0 to 1, as the mean and standard deviation of the underlying normal.",
      "properties": {
        "mu": {
          "type": "number"
        },
        "sigma": {
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "mu",
        "sigma"
      ],
      "type": "object"
    },
    "pooled": {
      "description": "Complete estimates of one part, pooled percentile by percentile.",
      "properties": {
        "mean": {
          "$ref": "#/$defs/range"
        },
        "median": {
          "$ref": "#/$defs/range"
        },
        "n": {
          "description": "How many estimates were pooled.",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "mean",
        "median",
        "n"
      ],
      "type": "object"
    },
    "range": {
      "description": "A 90% interval as three percentiles.",
      "properties": {
        "p05": {
          "description": "The lowest reasonable value, the 5th percentile.",
          "type": "number"
        },
        "p50": {
          "description": "The typical value, the 50th percentile.",
          "type": "number"
        },
        "p95": {
          "description": "The highest reasonable value, the 95th percentile.",
          "type": "number"
        }
      },
      "required": [
        "p05",
        "p50",
        "p95"
      ],
      "type": "object"
    }
  },
  "$id": "https://monorail.tech/schemas/tech.monorail.risk.study/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A panel's estimates of risk scenarios, pooled by simple averaging - the output of a group risk analysis. Each expert answers each statement with three-point estimates of its likelihood and its impact, each a 90% interval - a lowest reasonable value (5th percentile), a typical value (50th) and a highest reasonable value (95th). The panel is pooled percentile by percentile, by mean and by median. A statement may also carry loss curves simulated from the pooled estimates. Estimates are kept as entered; readers flag a range out of order rather than reject it.",
  "examples": [
    {
      "$type": "tech.monorail.risk.study",
      "currency": "USD",
      "experts": [
        {
          "id": "e1",
          "name": "Robin Example",
          "role": "Engineering"
        },
        {
          "id": "e2",
          "name": "Casey Example",
          "role": "Finance"
        }
      ],
      "held_on": "2026-11-19",
      "id": "2026-11-workshop",
      "organization": "Example Co",
      "statements": [
        {
          "estimates": [
            {
              "expert": "e1",
              "impact": {
                "p05": 50000,
                "p50": 400000,
                "p95": 3000000
              },
              "likelihood": {
                "p05": 0.02,
                "p50": 0.08,
                "p95": 0.25
              }
            },
            {
              "expert": "e2",
              "impact": {
                "p05": 100000,
                "p50": 600000,
                "p95": 5000000
              },
              "likelihood": {
                "p05": 0.01,
                "p50": 0.05,
                "p95": 0.2
              }
            }
          ],
          "id": "s1",
          "likelihood_kind": "probability",
          "panel": {
            "impact": {
              "mean": {
                "p05": 75000,
                "p50": 500000,
                "p95": 4000000
              },
              "median": {
                "p05": 75000,
                "p50": 500000,
                "p95": 4000000
              },
              "n": 2
            },
            "likelihood": {
              "mean": {
                "p05": 0.015,
                "p50": 0.065,
                "p95": 0.225
              },
              "median": {
                "p05": 0.015,
                "p50": 0.065,
                "p95": 0.225
              },
              "n": 2
            }
          },
          "statement": "A ransomware attack stops order processing for more than a day.",
          "timeframe": "the next 12 months"
        }
      ],
      "title": "Quantified risk workshop",
      "version": 1
    }
  ],
  "properties": {
    "$type": {
      "const": "tech.monorail.risk.study"
    },
    "body": {
      "description": "Notes, in Markdown.",
      "type": "string"
    },
    "currency": {
      "description": "ISO 4217 code for every impact and loss in this record.",
      "pattern": "^[A-Z]{3}$",
      "type": "string"
    },
    "experts": {
      "description": "The panel, whose estimates are pooled.",
      "items": {
        "properties": {
          "id": {
            "$ref": "https://legiblerecords.org/schemas/org.legiblerecords.common/v1.json#/$defs/slug",
            "description": "Unique in the study; estimates name the expert by it."
          },
          "name": {
            "type": "string",
            "x-data": [
              "user.name"
            ]
          },
          "role": {
            "description": "Discipline, team, or why they are on the panel.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "facilitators": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "x-data": [
        "user.name"
      ]
    },
    "held_on": {
      "$ref": "https://legiblerecords.org/schemas/org.legiblerecords.common/v1.json#/$defs/date",
      "description": "The day the panel answered, or the first, when it took several."
    },
    "id": {
      "$ref": "https://legiblerecords.org/schemas/org.legiblerecords.common/v1.json#/$defs/slug",
      "description": "This study's key, such as 2026-11-workshop, for references like risk-study:2026-11-workshop."
    },
    "organization": {
      "type": "string"
    },
    "produced_by": {
      "$ref": "https://legiblerecords.org/schemas/org.legiblerecords.common/v1.json#/$defs/produced_by"
    },
    "source": {
      "$ref": "https://legiblerecords.org/schemas/org.legiblerecords.common/v1.json#/$defs/source"
    },
    "source_fields": {
      "description": "The source's own fields that no field here covers, under the source's names. Readers keep it and don't interpret it. Never a personal value that a field here would label.",
      "type": "object"
    },
    "statements": {
      "items": {
        "properties": {
          "briefing": {
            "description": "What the panel was given before estimating, in plain text.",
            "type": "string"
          },
          "curves": {
            "description": "Loss curves simulated from pooled estimates, by Monte Carlo - beyond the averaging method itself.",
            "items": {
              "$ref": "#/$defs/curve"
            },
            "type": "array"
          },
          "estimates": {
            "description": "At most one per expert. An expert with none didn't answer. A part left out wasn't answered completely.",
            "items": {
              "properties": {
                "entered_by": {
                  "description": "The facilitator who entered it for the expert, such as from paper.",
                  "type": "string",
                  "x-data": [
                    "user.name"
                  ]
                },
                "expert": {
                  "$ref": "https://legiblerecords.org/schemas/org.legiblerecords.common/v1.json#/$defs/slug",
                  "description": "An id from experts."
                },
                "impact": {
                  "$ref": "#/$defs/range",
                  "description": "In the record's currency."
                },
                "impact_note": {
                  "description": "The expert's reasoning about impact.",
                  "type": "string"
                },
                "likelihood": {
                  "$ref": "#/$defs/range"
                },
                "likelihood_note": {
                  "description": "The expert's reasoning about likelihood.",
                  "type": "string"
                },
                "rationale": {
                  "description": "The expert's reasoning about the statement as a whole.",
                  "type": "string"
                }
              },
              "required": [
                "expert"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "horizon_months": {
            "description": "The length of that period in months; 12 is a year.",
            "minimum": 1,
            "type": "integer"
          },
          "id": {
            "$ref": "https://legiblerecords.org/schemas/org.legiblerecords.common/v1.json#/$defs/slug",
            "description": "Unique in the study."
          },
          "impact_question": {
            "description": "The question put to the panel about impact, when it wasn't the usual one.",
            "type": "string"
          },
          "likelihood_kind": {
            "description": "probability is the chance of at least one event in the timeframe, from 0 to 1; frequency is events per timeframe, which may exceed 1.",
            "examples": [
              "probability",
              "frequency"
            ],
            "type": "string"
          },
          "likelihood_question": {
            "description": "The question put to the panel about likelihood, when it wasn't the usual one.",
            "type": "string"
          },
          "panel": {
            "description": "The panel's estimates pooled, from every expert's complete answer.",
            "properties": {
              "impact": {
                "$ref": "#/$defs/pooled"
              },
              "likelihood": {
                "$ref": "#/$defs/pooled"
              }
            },
            "type": "object"
          },
          "statement": {
            "description": "The event being forecast, stated so it can be scored later.",
            "type": "string"
          },
          "timeframe": {
            "description": "The period the likelihood and every loss are for, as it was put to the panel, such as the next 12 months.",
            "type": "string"
          }
        },
        "required": [
          "estimates",
          "id",
          "likelihood_kind",
          "statement",
          "timeframe"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "title": {
      "type": "string"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "$type",
    "version",
    "currency",
    "experts",
    "id",
    "organization",
    "statements",
    "title"
  ],
  "title": "risk-study",
  "type": "object"
}
