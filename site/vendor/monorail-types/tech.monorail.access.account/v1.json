{
  "$id": "https://monorail.tech/schemas/tech.monorail.access.account/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "An account in one system, such as GitHub, Google Workspace or AWS, and the access it has there. It has person or person_match, or both, unless its kind is service or shared; a reader shows one without as unresolved. Large systems travel as a record set.",
  "examples": [
    {
      "$type": "tech.monorail.access.account",
      "access": [
        {
          "level": "write",
          "resource": "repo:acme/api",
          "via": "team:platform"
        }
      ],
      "id": "github-4183920",
      "kind": "person",
      "mfa": "on",
      "person_match": {
        "emails": [
          "ana@acme.example"
        ],
        "identifiers": [
          {
            "id": "4183920",
            "system": "github"
          }
        ]
      },
      "status": "active",
      "system": "github",
      "username": "ana-lima-acme",
      "version": 1
    }
  ],
  "properties": {
    "$type": {
      "const": "tech.monorail.access.account"
    },
    "access": {
      "description": "What the account can reach now, not what it should.",
      "items": {
        "properties": {
          "level": {
            "description": "The system's own level, such as read, write, admin or owner.",
            "type": "string"
          },
          "resource": {
            "description": "What, in the system's own terms, such as repo:acme/api, project:billing or org.",
            "type": "string"
          },
          "via": {
            "description": "How it is granted, such as team:platform, when not directly.",
            "type": "string"
          }
        },
        "required": [
          "level",
          "resource"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "admin": {
      "description": "An administrator of the whole system.",
      "type": "boolean"
    },
    "id": {
      "$ref": "https://legiblerecords.org/schemas/org.legiblerecords.common/v1.json#/$defs/slug",
      "description": "<system>-<the system's account id>, such as github-4183920."
    },
    "kind": {
      "examples": [
        "person",
        "service",
        "shared"
      ],
      "type": "string"
    },
    "last_active": {
      "$ref": "https://legiblerecords.org/schemas/org.legiblerecords.common/v1.json#/$defs/datetime"
    },
    "mfa": {
      "examples": [
        "on",
        "off",
        "unknown"
      ],
      "type": "string"
    },
    "person": {
      "$ref": "https://legiblerecords.org/schemas/org.legiblerecords.common/v1.json#/$defs/refString",
      "description": "Whose account it is, when they travel in the same bundle.",
      "ref": "person",
      "x-data": [
        "user.unique_id"
      ]
    },
    "person_match": {
      "$ref": "https://legiblerecords.org/schemas/org.legiblerecords.common/v1.json#/$defs/personMatch",
      "description": "Whose account it is, for a reader to match. Needs emails or identifiers.",
      "x-data": [
        "user.name",
        "user.contact.email.work",
        "user.unique_id"
      ]
    },
    "produced_by": {
      "$ref": "https://legiblerecords.org/schemas/org.legiblerecords.common/v1.json#/$defs/produced_by"
    },
    "source": {
      "$ref": "https://legiblerecords.org/schemas/org.legiblerecords.common/v1.json#/$defs/source"
    },
    "source_fields": {
      "description": "The source's own fields that no field here covers, under the source's names. Readers keep it and don't interpret it. Never a personal value that a field here would label.",
      "type": "object"
    },
    "status": {
      "examples": [
        "active",
        "suspended",
        "deleted"
      ],
      "type": "string"
    },
    "system": {
      "description": "The system, in lowercase, such as github, google, okta, slack or aws.",
      "pattern": "^[a-z0-9][a-z0-9.:-]*$",
      "type": "string"
    },
    "username": {
      "type": "string",
      "x-data": [
        "user.account.username"
      ]
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "$type",
    "version",
    "id",
    "status",
    "system",
    "username"
  ],
  "title": "account",
  "type": "object"
}
