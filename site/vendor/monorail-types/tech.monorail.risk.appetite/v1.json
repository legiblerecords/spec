{
  "$id": "https://monorail.tech/schemas/tech.monorail.risk.appetite/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "An organization's stated risk appetite - how large a loss it could absorb, and how rarely it can accept losses of each size.",
  "examples": [
    {
      "$type": "tech.monorail.risk.appetite",
      "currency": "USD",
      "decided_at": "2026-11-18",
      "id": "2026-11",
      "organization": "Example Co",
      "thresholds": [
        {
          "label": "A major setback",
          "level": "serious",
          "loss": 2000000,
          "one_in_years": 25
        },
        {
          "label": "Company-ending",
          "level": "existential",
          "loss": 8000000,
          "one_in_years": 200
        }
      ],
      "version": 1
    }
  ],
  "properties": {
    "$type": {
      "const": "tech.monorail.risk.appetite"
    },
    "approvals": {
      "items": {
        "properties": {
          "at": {
            "$ref": "https://legiblerecords.org/schemas/org.legiblerecords.common/v1.json#/$defs/datetime",
            "description": "When it was approved. Exactly one of at and on."
          },
          "name": {
            "type": "string",
            "x-data": [
              "user.name"
            ]
          },
          "on": {
            "$ref": "https://legiblerecords.org/schemas/org.legiblerecords.common/v1.json#/$defs/date",
            "description": "The day it was approved, when the source records only the day."
          },
          "role": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "role"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "body": {
      "description": "Notes, in Markdown.",
      "type": "string"
    },
    "currency": {
      "description": "ISO 4217 code for every amount in this record.",
      "pattern": "^[A-Z]{3}$",
      "type": "string"
    },
    "decided_at": {
      "$ref": "https://legiblerecords.org/schemas/org.legiblerecords.common/v1.json#/$defs/date",
      "description": "When leadership agreed to it."
    },
    "id": {
      "$ref": "https://legiblerecords.org/schemas/org.legiblerecords.common/v1.json#/$defs/slug",
      "description": "This appetite's key, such as 2026-11, for references like risk-appetite:2026-11."
    },
    "organization": {
      "type": "string"
    },
    "produced_by": {
      "$ref": "https://legiblerecords.org/schemas/org.legiblerecords.common/v1.json#/$defs/produced_by"
    },
    "replaces": {
      "$ref": "https://legiblerecords.org/schemas/org.legiblerecords.common/v1.json#/$defs/refString",
      "description": "The appetite this one supersedes.",
      "ref": "risk-appetite"
    },
    "review_by": {
      "$ref": "https://legiblerecords.org/schemas/org.legiblerecords.common/v1.json#/$defs/date"
    },
    "source": {
      "$ref": "https://legiblerecords.org/schemas/org.legiblerecords.common/v1.json#/$defs/source"
    },
    "thresholds": {
      "items": {
        "properties": {
          "label": {
            "description": "The organization's own words for this level.",
            "type": "string"
          },
          "level": {
            "description": "serious is a major setback; existential would end the company.",
            "examples": [
              "serious",
              "existential"
            ],
            "type": "string"
          },
          "loss": {
            "description": "In the record's currency.",
            "minimum": 0,
            "type": "number"
          },
          "one_in_years": {
            "description": "A loss at least this large no more often than once in this many years.",
            "minimum": 1,
            "type": "number"
          },
          "reasoning": {
            "type": "string"
          }
        },
        "required": [
          "level",
          "loss",
          "one_in_years"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "$type",
    "version",
    "currency",
    "decided_at",
    "id",
    "organization",
    "thresholds"
  ],
  "title": "risk-appetite",
  "type": "object"
}
