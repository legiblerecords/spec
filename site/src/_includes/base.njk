{%- set flat = [] -%}
{%- for group in nav %}{% for p in group.pages %}{% set flat = (flat.push(p), flat) %}{% endfor %}{% endfor -%}
{%- set prev = null -%}{%- set next = null -%}
{%- for p in flat -%}
  {%- if p.url == page.url -%}
    {%- if not loop.first %}{% set prev = flat[loop.index0 - 1] %}{% endif -%}
    {%- if not loop.last %}{% set next = flat[loop.index0 + 1] %}{% endif -%}
  {%- endif -%}
{%- endfor -%}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if page.url == "/" %}{{ site.name }}{% else %}{{ title }} · {{ site.name }}{% endif %}</title>
  {%- if description %}
  <meta name="description" content="{{ description }}">
  {%- endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&family=Atkinson+Hyperlegible+Mono:ital,wght@0,400;0,700;1,400&display=swap">
  <link rel="stylesheet" href="/css/site.css">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="alternate" type="text/markdown" href="{{ page.url | markdownUrl }}" title="This page as Markdown">
</head>
<body>
  <a class="skip" href="#content">Skip to content</a>
  <header class="top">
    <a class="brand" href="/">{{ site.name }} <small>draft</small></a>
    <nav aria-label="Primary">
      <a href="{{ site.spec }}">Spec</a>
      <a href="{{ site.tools }}">Tools</a>
      <a href="{{ site.spec }}/blob/main/CONTRIBUTING.md">Contribute</a>
    </nav>
  </header>

  <div class="wrap">
    <nav class="side" aria-label="Documentation">
      {%- for group in nav %}
      <h2>{{ group.heading }}</h2>
      <ul>
        {%- for p in group.pages %}
        <li><a href="{{ p.url }}"{% if p.url == page.url %} aria-current="page"{% endif %}>{{ p.title }}</a></li>
        {%- endfor %}
      </ul>
      {%- endfor %}
    </nav>

    <main id="content">
      <h1>{{ heading or title }}</h1>
      {%- if lede %}
      <p class="lede">{{ lede }}</p>
      {%- endif %}
      {{ content | safe }}

      <nav class="pager" aria-label="Previous and next">
        {% if prev %}<a href="{{ prev.url }}" rel="prev">← {{ prev.title }}</a>{% else %}<span></span>{% endif %}
        {% if next %}<a href="{{ next.url }}" rel="next">{{ next.title }} →</a>{% endif %}
      </nav>
      <p class="formats">This page as <a href="{{ page.url | markdownUrl }}">Markdown</a>. For language models: <a href="/llms.txt">llms.txt</a>, or the whole site in <a href="/llms-full.txt">llms-full.txt</a>.</p>
    </main>
  </div>

  <footer>Legible Records is a draft, maintained by <a href="https://monorail.tech">Monorail</a>. Text <a href="{{ site.spec }}/blob/main/spec/LICENSE">CC BY 4.0</a>, schemas <a href="/schemas/LICENSE">CC0</a>, code <a href="{{ site.spec }}/blob/main/LICENSE">Apache 2.0</a>.</footer>
</body>
</html>
